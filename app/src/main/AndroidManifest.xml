<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pleos Vehicle SDK 읽기 권한 (vehicle-permission 문서) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />   <!-- DrivingMode(기어), Brake -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />  <!-- TurnSignal -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />   <!-- Seat 착좌 -->
    <uses-permission android:name="pleos.car.permission.READ_CAR_STEERING" /> <!-- SteeringWheel 각도 (공식 샘플앱 기준) -->
    <uses-permission android:name="pleos.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />      <!-- AAOS 차속 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" /> <!-- AAOS 기어 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <application android:label="@string/app_name" android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 화면 유지: 운전자 주의분산 최적화(DO) 선언. 주행 중 화면은 글자 최소·음성 중심이어야 함 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
    </application>
</manifest>
